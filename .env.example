# =========================================================
# Kilombo — Portal environment variables (EXAMPLE / PLANTILLA)
# =========================================================
# COPIA ESTE ARCHIVO como `.env` y rellénalo con los valores reales.
# NO edites este archivo .env.example con credenciales reales,
# porque es el que se sube al repositorio público.

# ---------------------------------------------------------
# GitHub
# ---------------------------------------------------------
# Repositorio remoto del proyecto (código y contenido)
GITHUB_REPO_URL=https://github.com/TU_USUARIO/TU_REPO

# Personal Access Token con permisos de lectura/escritura sobre el repo
# Generar en: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contraseña compartida para el cifrado del espejo (StatiCrypt AES-256)
# Se usa en el paso de build de GitHub Actions para cifrar las páginas de
# contenido. Añadirla también como GitHub Actions Secret con el nombre
# STATICRYPT_PASSWORD en: Settings → Secrets → Actions → New repository secret
STATICRYPT_PASSWORD=CAMBIA_ESTA_CONTRASENIA_DEL_ESPEJO

# ---------------------------------------------------------
# Servidor / YunoHost — kilombo.top
# ---------------------------------------------------------
# Credenciales de acceso para despliegue SFTP/SCP/SSH
# (Panel de administración YunoHost y/o cuenta de sistema)
KILOMBOTOP_HOST=kilombo.top
KILOMBOTOP_PORT=22
KILOMBOTOP_USER=admin
KILOMBOTOP_PASSWORD=CAMBIA_ESTA_CONTRASENIA

# Path remoto donde se publica el portal
# (carpeta del virtual host en YunoHost — ajustar si es distinta)
KILOMBOTOP_REMOTE_PATH=/var/www/kilombo.top

# Credencial de administración que se usará una vez migrado
# el flujo de publicación a producción final.
KILOMBOTOP_FUTURE_PASSWORD=CAMBIA_ESTA_CONTRASENIA_TAMBIEN

# ---------------------------------------------------------
# Red interna de sitios Kilombo / Mirror sites
# ---------------------------------------------------------
# Son los sitios "hermanos" que ya existen en la infraestructura
# YunoHost de Kilombo y que el nuevo portal central referencia
# y agrupa. Se guardan aquí para que los scripts (scrapers,
# detectores de enlaces rotos, agregadores de últimas noticias,
# sincronizadores de traducciones, etc.) puedan leerlos.
#
# Acceso central (Single Sign-On de YunoHost):
KILOMBO_SSO_URL=https://kilombo.top/yunohost/sso/

# 1) Espacio Tierra y Libertad (destacado — plataforma editorial principal)
KILOMBO_SITE_TIERRA_URL=https://www.kilombo.top/
KILOMBO_SITE_TIERRA_LANGS=es,fr
KILOMBO_SITE_TIERRA_STATUS=active

# 2) GCI / ICG — Sitio oficial (división 01)
KILOMBO_SITE_GCI_URL=https://icg-gci.kilombo.top/
KILOMBO_SITE_GCI_LANGS=es,en,fr
KILOMBO_SITE_GCI_STATUS=active

# 2b) International Global Revolution — plataforma anglófona del GCI
KILOMBO_SITE_GCI_EN_URL=https://in.kilombo.top/
KILOMBO_SITE_GCI_EN_LANGS=en,ku,fa,ar
KILOMBO_SITE_GCI_EN_STATUS=active

# 2c) ICG / GCI CD-Rom — archivo multilingüe histórico
KILOMBO_SITE_GCI_CDROM_URL=https://cdrom.kilombo.top/
KILOMBO_SITE_GCI_CDROM_LANGS=fr,es,en,multi
KILOMBO_SITE_GCI_CDROM_STATUS=archive

# 2d) ICG Sitio Histórico / antiguo (legacy)
KILOMBO_SITE_GCI_OLD_URL=https://icg-old.kilombo.top/
KILOMBO_SITE_GCI_OLD_LANGS=multi
KILOMBO_SITE_GCI_OLD_STATUS=legacy

# 3) Proletarios Internacionalistas — publicación P.I. / I.P. (división 02)
KILOMBO_SITE_PI_URL=https://proletariosinternacionalistas.kilombo.top/
KILOMBO_SITE_PI_LANGS=es,fr
KILOMBO_SITE_PI_STATUS=active

# ---------------------------------------------------------
# Espacios amigos / fuentes colaboradoras (NO son sitios Kilombo)
# ---------------------------------------------------------
# Contenidos compartidos por organizaciones y personas aliadas.
# Se presentan con tono de colaboración (nunca "curación" / filtrado).

# A) Canal7 Salta TV — videos para la sección Plandemismo (división 03)
FRIEND_CANAL7TV_URL=https://tv.canal7salta.com/
FRIEND_CANAL7TV_NATURE=video_platform
FRIEND_CANAL7TV_SECTIONS=actualidad,sida_covid,historicos

# ---------------------------------------------------------
# Prototipos y sitios de previsualización (cliente)
# ---------------------------------------------------------
# Rediseños provisionales que el cliente ha usado para mostrar
# estructura al resto del equipo. Referencia, NO producción.
PROTOTYPE_REPLIT_KILOMBO_REDESIGN=https://kilombo-redesign--ukoquique.replit.app/

# URL del túnel público de preview (Serveo / ngrok) actual
# (se actualiza a mano cada vez que se reinicia el túnel)
PREVIEW_PUBLIC_URL=https://CAMBIA_ESTA_URL-cuando-reinicies-el-tunel.serveousercontent.com
