# =========================================================
# Kilombo — Portal environment variables (TEMPLATE)
# =========================================================
# Este archivo es un TEMPLATE para .env (no subir a repositorio público).
# COPIA ESTE ARCHIVO como `.env` y rellena los valores con credenciales reales.
# IMPORTANTE: Este archivo define la estructura y variables esperadas.
# Mantenerlo sincronizado con .env en cada cambio de variables.

# ---------------------------------------------------------
# Local development paths (to avoid typos like KILOMBO vs KILOMBO)
# ---------------------------------------------------------
# Absolute paths to key directories in local workspace.
# Used by scripts (md-to-json.mjs, publish-to-actualidad.mjs, etc.) to avoid
# hardcoded paths and prevent typos.
# These are set automatically by sourcing .env in scripts — do NOT modify
# unless your workspace directory structure changes.
#
# Example (adjust to your actual paths):
LOCAL_WORKSPACE_ROOT=/root/JOB-sda2/KILOMBO-SITE
LOCAL_KILOMBO_BUILD=$LOCAL_WORKSPACE_ROOT/KILOMBO-BUILD
LOCAL_KILOMBO_DIR=$LOCAL_KILOMBO_BUILD/KILOMBO
LOCAL_ARTICLES_JSON=$LOCAL_KILOMBO_DIR/site/assets/content/articles.json
LOCAL_ARTICULOS_READY=$LOCAL_KILOMBO_BUILD/articulos_en_trabajo/READY

# ---------------------------------------------------------
# GitHub
# ---------------------------------------------------------
# Repositorio remoto del proyecto (código y contenido)
GITHUB_REPO_URL=https://github.com/TU_USUARIO/TU_REPO

# Personal Access Token con permisos de lectura/escritura sobre el repo
# Generar en: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------
# Servidor / YunoHost — kilombo.top
# ---------------------------------------------------------
# Credenciales de acceso para despliegue SFTP/SCP/SSH
# (Panel de administración YunoHost y/o cuenta de sistema)
KILOMBOTOP_HOST=kilombo.top
KILOMBOTOP_PORT=22
KILOMBOTOP_USER=kilombo
KILOMBOTOP_PASSWORD=CAMBIA_ESTA_CONTRASENIA

# Path remoto donde se publica el portal (carpeta del virtual host en YunoHost)
KILOMBOTOP_REMOTE_PATH=/var/www/kilombo.top

# Contraseña futura — reemplazará a KILOMBOTOP_PASSWORD una vez activada.
# Cuando el cliente confirme el cambio: copiar este valor a KILOMBOTOP_PASSWORD
# y eliminar esta línea.
# NOTA: si el valor contiene caracteres especiales de shell ($, &, !, etc.)
# debe ir entre comillas simples para que el sourcing de bash no lo interprete.
# EJEMPLO: KILOMBOTOP_FUTURE_PASSWORD='MyP@ssw0rd!2024#Secure'
KILOMBOTOP_FUTURE_PASSWORD='CAMBIA_ESTA_CONTRASENIA_CON_ESCAPING_SI_NECESARIO'

# Contraseña OPCIONAL para Escal theme editing (KILO-002 Credential Scoping)
# 
# FASE 1 (ahora): Los scripts de tema (customize-escal-theme.mjs, probe-escal-fields.mjs)
# usan la credencial full-admin (KILOMBOTOP_PASSWORD). Si deseas mantener esta
# configuración, NO necesitas esta variable.
#
# FASE 2 (futuro): Una vez que SPIP 4.4.15 soporte roles más estrechos (Escal Editor),
# crea una cuenta separada con permisos limitados y pon su contraseña aquí.
# Los scripts automáticamente la preferirán sobre KILOMBOTOP_PASSWORD.
#
# Ver docs/RISK-REGISTER.json KILO-002 para más información sobre la roadmap
# de credential scoping.
#
# Déjalo en blanco o comentado para usar la credencial full-admin actual.
# KILOMBOTOP_ESCAL_PASSWORD=CONTRASENIA_ESCAL_NARROWER_OPCIONAL

# Contraseña compartida para el cifrado del espejo (StatiCrypt AES-256).
# ⚠️  IMPORTANTE: Esta contraseña DEBE estar:
#   1. En este archivo .env (para encrypt local: `STATICRYPT_PASSWORD=... npm run encrypt`)
#   2. En GitHub Actions Secrets (Settings → Secrets → Actions → STATICRYPT_PASSWORD)
# Se usa en el paso de build de GitHub Actions (deploy.yml) para cifrar las páginas.
STATICRYPT_PASSWORD=TU_CONTRASENIA_SECRETA_PARA_CIFRADO

# ---------------------------------------------------------
# Shared secret for Management Dashboard API
# ---------------------------------------------------------
# This secret is REQUIRED for running the management Express server.
# The server enforces the presence of `KILO_SHARED_SECRET` and will refuse
# to start if it is not set. Keep a strong random value and do NOT commit
# real secrets to the repository. The API expects requests to include the
# header `x-kilo-secret: <secret>` when calling protected endpoints.
# Example (change to a strong secret before use):
# KILO_SHARED_SECRET='replace-with-a-strong-random-string-32-64-chars'
KILO_SHARED_SECRET='REPLACE_ME_WITH_A_STRONG_SECRET'

# ---------------------------------------------------------
# Groq AI — Article improvement (Fase 6 IA)
# ---------------------------------------------------------
# API key for Groq LLM API (https://console.groq.com/keys)
# Required to activate /api/drafts/:slug/improve endpoint.
# Without this key the endpoint returns 501 NOT_IMPLEMENTED.
GROQ_API_KEY=REPLACE_ME_WITH_GROQ_API_KEY

# ---------------------------------------------------------
# Red interna de sitios Kilombo / Mirror sites
# ---------------------------------------------------------
# Son los sitios "hermanos" que ya existen en la infraestructura
# YunoHost de Kilombo y que el nuevo portal central referencia
# y agrupa. Se guardan aquí para que los scripts (scrapers,
# detectores de enlaces rotos, agregadores de últimas noticias,
# sincronizadores de traducciones, etc.) puedan leerlos.
#
# Acceso central (Single Sign-On de YunoHost):
KILOMBO_SSO_URL=https://kilombo.top/yunohost/sso/

# 1) Espacio Tierra y Libertad (destacado — plataforma editorial principal)
KILOMBO_SITE_TIERRA_URL=https://www.kilombo.top/
KILOMBO_SITE_TIERRA_LANGS=es,fr
KILOMBO_SITE_TIERRA_STATUS=active

# 2) GCI / ICG — Sitio oficial (división 01)
KILOMBO_SITE_GCI_URL=https://icg-gci.kilombo.top/
KILOMBO_SITE_GCI_LANGS=es,en,fr
KILOMBO_SITE_GCI_STATUS=active

# 2b) International Global Revolution — plataforma anglófona del GCI
KILOMBO_SITE_GCI_EN_URL=https://in.kilombo.top/
KILOMBO_SITE_GCI_EN_LANGS=en,ku,fa,ar
KILOMBO_SITE_GCI_EN_STATUS=active

# 2c) ICG / GCI CD-Rom — archivo multilingüe histórico
KILOMBO_SITE_GCI_CDROM_URL=https://cdrom.kilombo.top/
KILOMBO_SITE_GCI_CDROM_LANGS=fr,es,en,multi
KILOMBO_SITE_GCI_CDROM_STATUS=archive

# 2d) ICG Sitio Histórico / antiguo (legacy)
KILOMBO_SITE_GCI_OLD_URL=https://icg-old.kilombo.top/
KILOMBO_SITE_GCI_OLD_LANGS=multi
KILOMBO_SITE_GCI_OLD_STATUS=legacy

# 3) Proletarios Internacionalistas — publicación P.I. / I.P. (división 02)
KILOMBO_SITE_PI_URL=https://proletariosinternacionalistas.kilombo.top/
KILOMBO_SITE_PI_LANGS=es,fr
KILOMBO_SITE_PI_STATUS=active

# ---------------------------------------------------------
# Espacios amigos / fuentes colaboradoras (NO son sitios Kilombo)
# ---------------------------------------------------------
# Contenidos compartidos por organizaciones y personas aliadas.
# Se presentan con tono de colaboración (nunca "curación" / filtrado).

# A) Canal7 Salta TV — videos para la sección Plandemismo (división 03)
FRIEND_CANAL7TV_URL=https://tv.canal7salta.com/
FRIEND_CANAL7TV_NATURE=video_platform
FRIEND_CANAL7TV_SECTIONS=actualidad,sida_covid,historicos

# ---------------------------------------------------------
# Prototipos y sitios de previsualización (cliente)
# ---------------------------------------------------------
# Rediseños provisionales que el cliente ha usado para mostrar
# estructura al resto del equipo. Referencia, NO producción.
PROTOTYPE_REPLIT_KILOMBO_REDESIGN=https://kilombo-redesign--ukoquique.replit.app/

# URL del espejo público (GitHub Pages o túnel Serveo si está activo)
# GitHub Pages: https://TU_USUARIO.github.io/kilombo/
# Serveo (temporal): https://NOMBRE-cuando-reinicies-el-tunel.serveousercontent.com
PREVIEW_PUBLIC_URL=https://ukoquique-proves.github.io/kilombo/
