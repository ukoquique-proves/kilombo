{
  "name": "kilombo",
  "version": "0.40.2",
  "description": "Portal central de acceso a la red de sitios de Kilombo. Construido como página estática (HTML, CSS, JS) para ser alojado en la infraestructura YunoHost de `kilombo.top`.",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "bash scripts/test.sh",
    "import-article": "node scripts/import-article.mjs",
    "backfill-dates": "node scripts/backfill-dates.mjs",
    "i18n-coverage": "node scripts/i18n-coverage.mjs",
    "encrypt": "node scripts/encrypt.mjs",
    "preview": "python3 -m http.server 8080 --directory site",
    "scrape": "bash sandbox/scrape-curl.sh",
    "scrape:full": "bash sandbox/scrape-comprehensive.sh",
    "check-corruption": "node scripts/detect-fixed-column-corruption.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "happy-dom": "^20.11.1",
    "staticrypt": "3.5.4"
  }
}
